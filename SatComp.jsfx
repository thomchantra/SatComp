gmode == 1 ? sprintf(#s1, "TRIM %+.1fdB", atrim) : gmode == 2 ? (
  meas ? sprintf(#s1, "MEAS %.1f/3.0s", mt) : sprintf(#s1, "LOCK %+.1fdB", slider24);
) : sprintf(#s1, "TRIM ---");
Rtext(464, 70, #s1);
opk_max > 0.00001 ? sprintf(#s1, "PK %+.1fdB", 8.6858896*log(opk_max)) : strcpy(#s1, "PK ---");
setc(opk_max > 0.9999); Rtext(464, 88, #s1); setc(0);
fms > 0.000000001 ? sprintf(#s1, "RMS %+.1fdB", 4.3429448*log(fms)) : strcpy(#s1, "RMS ---");
Rtext(464, 100, #s1);
slider26 > 0.5 ? ( sprintf(#s1, "BYP %+.1fdB", 8.6858896*log(bg)); Rtext(464, 112, #s1); );

