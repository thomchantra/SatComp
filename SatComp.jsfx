desc:SatComp
tags:distortion compressor saturation dynamics
options:no_meter

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

// ---- SAT ----
slider1:0<0,13,1{Tube,Soft,Rational,Atan,Hard,Tri Fold,Sine Fold,Crossover,Cheby,Wrap,Rectify,Bitcrush,Asym Fold,Diode}>-Shape
slider2:25<0,100,0.1>-Drive
slider3:0<-100,100,0.1>-Bias
slider4:20<20,2000,1>-Sat HP
slider5:20000<1000,20000,1>-Sat LP
slider6:20000<1000,20000,1>-Tone
slider7:0<0,2,1{Off,x2,x4}>-OS
// ---- COMP ----
slider8:-18<-40,0,0.1>-Thresh
slider9:4<1,20,0.1>-Ratio
slider10:10<0.05,100,0.01>-Attack
slider11:150<5,2000,1>-Release
slider12:50<0,100,1>-Speed
slider13:6<0,24,0.1>-Knee
slider14:0<0,100,1>-Knee Shape
slider15:30<0,100,1>-Detector
slider16:0<0,400,1>-Det HP
slider17:100<0,100,1>-Link
slider18:0<0,100,1>-FF/FB
slider19:0<0,100,1>-GR Dist
// ---- OUT ----
slider20:0<0,24,0.1>-Makeup
slider21:100<0,100,1>-Mix
slider22:0<-24,12,0.1>-Out Gain
slider23:0<0,2,1{Manual,Auto,Match}>-GainMatch
slider24:0<-24,24,0.01>-Match Trim
slider25:100<0,100,1>-Sat Mix
slider26:0<0,1,1{Off,On}>-Bypass
slider27:0<-24,12,0.1>-Sat Out

@init
ext_noinit = 1;
gfx_ext_retina = 1;   // crisp on HiDPI: gfx_w, mouse and drawing all in device px; UI scale S derives from gfx_w

// ============================================================ memory map
lut = 0;                       // 4097 pts, shaper over +-8
tpA = 4100;  tpB = 4130;       // halfband odd-tap tables (K=24 / K=8)
stAL = 4200; stAR = stAL+128; stBL = stAR+128; stBR = stBL+128;   // halfband stage state
dryL = 4800; dryR = 4864; resL = 4928; resR = 4992;               // 64-sample delay rings
bdL = 5300; bdR = 5364;                                           // band-limited sat input, delayed (sat mix dry leg)
hpc = 5100; lpc = 5110; tnc = 5120; dhc = 5130;                   // biquad coeffs
hpsL = 5200; hpsR = 5208; lpsL = 5216; lpsR = 5224;               // biquad states
tnsL = 5232; tnsR = 5240; dhsL = 5248; dhsR = 5256;
pmin = 6000; pmax = 6040; pdef = 6080; pmode = 6120; psnap = 6160; pstep = 6200;  // UI param table
memset(stAL, 0, 520); memset(dryL, 0, 256); memset(hpsL, 0, 64); memset(bdL, 0, 128);

// ============================================================ DSP helpers
function th(x) local(e) (
  x = min(max(x, -20), 20);
  e = exp(2*x);
  (e - 1)/(e + 1);
);

// All shapers: odd/even as named, unity small-signal slope (Crossover: unity large-signal slope)
function shp(sel, x) local(y, ax, t) (
  y = 0;
  sel == 0 ? ( y = x >= 0 ? th(x) : th(0.6*x)/0.6; );              // Tube: asymmetric knees
  sel == 1 ? ( y = th(x); );                                        // Soft
  sel == 2 ? ( y = x/(1 + 1.5*abs(x)); );                           // Rational (Gruhn form, k=1.5, slope-normalised)
  sel == 3 ? ( y = 0.63661977*atan(1.5707963*x); );                 // Atan
  sel == 4 ? ( ax = abs(x); y = ax <= 0.9 ? x : sign(x)*(0.9 + 0.1*th((ax - 0.9)*10)); );  // Hard, rounded
  sel == 5 ? ( y = 0.63661977*asin(sin(1.5707963*x)); );            // Tri Fold
  sel == 6 ? ( y = sin(1.5707963*x)*0.63661977; );                  // Sine Fold
  sel == 7 ? ( y = x - 0.12*th(x/0.15); );                          // Crossover / dead zone
  sel == 8 ? ( t = th(x); y = 1.6*t + 0.6*t*t + 0.2*(4*t*t*t - 3*t); );  // Cheby T1 + T2 + T3
  sel == 9 ? ( y = x - 2*floor((x + 1)*0.5); );                     // Wrap: modulo wraparound into [-1,1), hard discontinuities
  sel == 10 ? ( y = 0.25*th(x) + 0.75*th(abs(x)); );                // Rectify: positive half unchanged, negative half flipped at 1/2 gain (even harmonics, DC blocked after)
  sel == 11 ? ( y = min(max(floor(x*8 + 0.5)*0.125, -1), 1); );     // Bitcrush: 8 steps per unit (~4 bit), clipped at +-1
  sel == 12 ? ( y = (sin(1.5707963*(x + 0.35)) - 0.52249856)*0.63661977/0.85264016; );  // Asym Fold: sine fold with offset, unity slope + zero at origin
  sel == 13 ? ( y = x >= 0 ? 1 - exp(-x) : -0.6*(1 - exp(x/0.6)); ); // Diode: exponential knee, +1 / -0.6 asymmetric
  y;
);

function build_lut(sel) local(i) (
  i = 0;
  loop(4097, lut[i] = shp(sel, i/256 - 8); i += 1; );
);

// periodic shapers (folds, wrap, asym fold; period divides 4) are reduced into range instead of clamped, so they keep folding at any drive
function lutf(x) local(p, i, f) (
  per_on && abs(x) > 6 ? ( x -= 4*floor(x*0.25 + 0.5); );
  p = (min(max(x, -7.999), 7.999) + 8)*256;
  i = floor(p); f = p - i;
  lut[i] + (lut[i+1] - lut[i])*f;
);

// ---- biquads (TDF2). state s[0..1], coeffs c[0..4] = b0 b1 b2 a1 a2
function bq(s, c, x) local(y) (
  y = c[0]*x + s[0] + 0.000000000000000000000000000001;
  s[0] = c[1]*x - c[3]*y + s[1];
  s[1] = c[2]*x - c[4]*y;
  y;
);
function bq_lp(c, f, q) local(w, cs, al, a0) (
  w = 2*$pi*min(f, srate*0.45)/srate; cs = cos(w); al = sin(w)/(2*q); a0 = 1 + al;
  c[0] = (1 - cs)*0.5/a0; c[1] = (1 - cs)/a0; c[2] = c[0]; c[3] = -2*cs/a0; c[4] = (1 - al)/a0;
);
function bq_hp(c, f, q) local(w, cs, al, a0) (
  w = 2*$pi*min(f, srate*0.45)/srate; cs = cos(w); al = sin(w)/(2*q); a0 = 1 + al;
  c[0] = (1 + cs)*0.5/a0; c[1] = -(1 + cs)/a0; c[2] = c[0]; c[3] = -2*cs/a0; c[4] = (1 - al)/a0;
);

// ---- halfband (N = 2K+1, Kaiser). Taps table tp[j] = h[2j+1], sum = 0.5.
function i0(x) local(sm, t, k) (
  sm = 1; t = 1; k = 1;
  loop(30, t *= (x*0.5/k)*(x*0.5/k); sm += t; k += 1; );
  sm;
);
function mk_taps(tp, K, beta) local(j, m, r, w, h, sm) (
  sm = 0; j = 0;
  loop(K,
    m = 2*j + 1 - K; r = m/K;
    w = i0(beta*sqrt(1 - r*r))/i0(beta);
    h = sin($pi*m*0.5)/($pi*m*0.5)*0.5*w;
    tp[j] = h; sm += h; j += 1;
  );
  j = 0; loop(K, tp[j] *= 0.5/sm; j += 1; );
);
// state block s: s[0]=up pos, s[1]=down pos, up ring at s+2, down ring at s+40
// up: one input -> hy0 (even output), hy1 (odd output)
function hb_up(s, tp, K, um, x) local(p, j, acc) (
  p = s[0];
  s[2 + p] = x;
  hy0 = s[2 + ((p - K*0.5 + um + 1) & um)];
  acc = 0; j = 0;
  loop(K, acc += tp[j]*s[2 + ((p - j + um + 1) & um)]; j += 1; );
  hy1 = 2*acc;
  s[0] = (p + 1) & um;
);
// down: pair (a=even, b=odd) -> one output
function hb_down(s, tp, K, dm, a, b) local(q, acc, j) (
  q = s[1];
  s[40 + q] = a;
  acc = 0.5*s[40 + ((q - K + dm + 1) & dm)];
  j = 0;
  loop(K, acc += tp[j]*s[40 + ((q - 2*j - 1 + dm + 1) & dm)]; j += 1; );
  q = (q + 1) & dm; s[40 + q] = b; s[1] = (q + 1) & dm;
  acc;
);

// shaper with optional 2x/4x oversampling around it (os: 0 off, 1 x2, 2 x4)
function sh_proc(sA, sB, x) local(a0, a1, b0, b1, b2, b3, c0, c1) (
  os == 0 ? lutf(x) : os == 1 ? (
    hb_up(sA, tpA, 24, 31, x); a0 = hy0; a1 = hy1;
    hb_down(sA, tpA, 24, 63, lutf(a0), lutf(a1));
  ) : (
    hb_up(sA, tpA, 24, 31, x); a0 = hy0; a1 = hy1;
    hb_up(sB, tpB, 8, 7, a0); b0 = hy0; b1 = hy1;
    hb_up(sB, tpB, 8, 7, a1); b2 = hy0; b3 = hy1;
    c0 = hb_down(sB, tpB, 8, 15, lutf(b0), lutf(b1));
    c1 = hb_down(sB, tpB, 8, 15, lutf(b2), lutf(b3));
    hb_down(sA, tpA, 24, 63, c0, c1);
  );
);

// ---- gain computer: returns GR in dB (>= 0). C1 knee, family morphs quad -> smoothstep -> smootherstep
function gcomp(x) local(d, u, u2, u3, u4, G) (
  d = x - thr;
  knw > 0.001 ? (
    d <= -knw*0.5 ? 0 : d >= knw*0.5 ? d*cslope : (
      u = (d + knw*0.5)/knw; u2 = u*u; u3 = u2*u; u4 = u2*u2;
      G = kc0*u2*0.5 + kc1*(u3 - u4*0.5) + kc2*(u4*u2 - 3*u4*u + 2.5*u4);
      cslope*knw*G;
    );
  ) : ( d > 0 ? d*cslope : 0; );
);

// ============================================================ UI widget kit (used by @gfx)
// ---- parameter table
function setp(n, mn, mx2, df, md, sn, st) (
  pmin[n] = mn; pmax[n] = mx2; pdef[n] = df; pmode[n] = md; psnap[n] = sn; pstep[n] = st;
);

// slider access split in short ternary chains (one 26-deep chain left sliders 25/26 unwritable)
function sget_a(n) (
  n==1 ? slider1 : n==2 ? slider2 : n==3 ? slider3 : n==4 ? slider4 : n==5 ? slider5 : n==6 ? slider6 :
  n==7 ? slider7 : n==8 ? slider8 : slider9;
);
function sget_b(n) (
  n==10 ? slider10 : n==11 ? slider11 : n==12 ? slider12 : n==13 ? slider13 : n==14 ? slider14 :
  n==15 ? slider15 : n==16 ? slider16 : n==17 ? slider17 : slider18;
);
function sget_c(n) (
  n==19 ? slider19 : n==20 ? slider20 : n==21 ? slider21 : n==22 ? slider22 : n==23 ? slider23 :
  n==24 ? slider24 : n==25 ? slider25 : n==26 ? slider26 : slider27;
);
function sget(n) ( n <= 9 ? sget_a(n) : n <= 18 ? sget_b(n) : sget_c(n); );
function sput_a(n, v) (
  n==1 ? (slider1=v) : n==2 ? (slider2=v) : n==3 ? (slider3=v) : n==4 ? (slider4=v) : n==5 ? (slider5=v) :
  n==6 ? (slider6=v) : n==7 ? (slider7=v) : n==8 ? (slider8=v) : (slider9=v);
);
function sput_b(n, v) (
  n==10 ? (slider10=v) : n==11 ? (slider11=v) : n==12 ? (slider12=v) : n==13 ? (slider13=v) :
  n==14 ? (slider14=v) : n==15 ? (slider15=v) : n==16 ? (slider16=v) : n==17 ? (slider17=v) : (slider18=v);
);
function sput_c(n, v) (
  n==19 ? (slider19=v) : n==20 ? (slider20=v) : n==21 ? (slider21=v) : n==22 ? (slider22=v) :
  n==23 ? (slider23=v) : n==24 ? (slider24=v) : n==25 ? (slider25=v) : n==26 ? (slider26=v) :
  (slider27=v);
);
function sput(n, v) ( n <= 9 ? sput_a(n, v) : n <= 18 ? sput_b(n, v) : sput_c(n, v); );
function sset(n, v) (
  sput(n, v);
  sliderchange(2^(n-1));
  slider_automate(2^(n-1));
  dirty = 1;
);
function end_touch(n) ( slider_automate(2^(n-1), 1); );

function n2t(n, v) local(mn, mx2, md, t) (
  mn = pmin[n]; mx2 = pmax[n]; md = pmode[n];
  t = md == 1 ? log(max(v, mn)/mn)/log(mx2/mn) :
      md == 2 ? sqrt(max(v - mn, 0)/(mx2 - mn)) : (v - mn)/(mx2 - mn);
  min(max(t, 0), 1);
);
function t2n(n, t) local(mn, mx2, md, v, sn, st) (
  mn = pmin[n]; mx2 = pmax[n]; md = pmode[n]; sn = psnap[n]; st = pstep[n];
  (sn & 1) && t < 0.03 ? ( t = 0; );
  (sn & 2) && t > 0.97 ? ( t = 1; );
  v = md == 1 ? mn*exp(t*log(mx2/mn)) : md == 2 ? mn + (mx2 - mn)*t*t : mn + (mx2 - mn)*t;
  st > 0 ? ( v = floor(v/st + 0.5)*st; );
  min(max(v, mn), mx2);
);
function commit(n, t) local(v) (
  v = t2n(n, t);
  v != sget(n) ? sset(n, v);
);

function hit(x, y, w, h) ( mx >= x && mx < x + w && my >= y && my < y + h );

// ---- drawing primitives (logical -> device px)
function setc(red) ( red ? gfx_set(1, 0, 0, 1) : inv ? gfx_set(0, 0, 0, 1) : gfx_set(1, 1, 1, 1); );
function setbg() ( inv ? gfx_set(1, 1, 1, 1) : gfx_set(0, 0, 0, 1); );   // text colour on filled (lit) widgets = background colour
function Rfill(x, y, w, h) local(x0, y0) (   // edges snapped to whole device px so borders stay uniform at fractional S
  x0 = floor(ox + x*S + 0.5); y0 = floor(oy + y*S + 0.5);
  gfx_rect(x0, y0, max(1, floor(ox + (x + w)*S + 0.5) - x0), max(1, floor(oy + (y + h)*S + 0.5) - y0));
);
function Rbox(x, y, w, h) ( Rfill(x, y, w, 1); Rfill(x, y + h - 1, w, 1); Rfill(x, y, 1, h); Rfill(x + w - 1, y, 1, h); );
function Rtext(x, y, str) ( gfx_x = ox + x*S; gfx_y = oy + y*S; gfx_drawstr(str); );
function Rtextc(x, y, w, str) local(tw, th2) (
  gfx_measurestr(str, tw, th2);
  gfx_x = ox + x*S + (w*S - tw)*0.5; gfx_y = oy + y*S; gfx_drawstr(str);
);
function Rline(x1, y1, x2, y2) local(k) (
  k = 0;
  loop(max(1, floor(S + 0.5)), gfx_line(ox + x1*S + k, oy + y1*S, ox + x2*S + k, oy + y2*S, 0);
          gfx_line(ox + x1*S, oy + y1*S + k, ox + x2*S, oy + y2*S + k, 0); k += 1; );
);

// ---- font: Fira Code, falls back to a monospace if the face is missing (detected by equal glyph widths)
function font_try(i) (
  i == 0 ? strcpy(#fname, "Fira Code") : i == 1 ? strcpy(#fname, "Menlo") :
  i == 2 ? strcpy(#fname, "Consolas") : strcpy(#fname, "Courier New");
);
function pick_font() local(i, w1, w2, h1, ok) (
  i = 0; ok = 0;
  while (i < 4 && !ok) (
    font_try(i);
    gfx_setfont(2, #fname, floor(14*S + 0.5));
    gfx_measurestr("iiiiiiii", w1, h1); gfx_measurestr("WWWWWWWW", w2, h1);
    w1 == w2 ? ( ok = 1; ) : ( i += 1; );
  );
  i >= 4 ? font_try(3);
  gfx_setfont(1, #fname, max(6, floor(12*S + 0.5)));
  gfx_setfont(2, #fname, max(6, floor(14*S + 0.5)));
  gfx_setfont(3, #fname, max(8, floor(18*S + 0.5)));
);

// ---- formatting
function fmt(n, v) (
  n == 2 || n == 12 || n == 14 || n == 15 || n == 17 || n == 18 || n == 19 || n == 21 || n == 25 ? sprintf(#vs, "%.0f%%", v) :
  n == 3 ? sprintf(#vs, "%+.0f%%", v) :
  n == 4 || n == 16 ? ( v <= (n == 4 ? 20.5 : 15) ? strcpy(#vs, "OFF") : sprintf(#vs, "%.0fHz", v); ) :
  n == 5 || n == 6 ? ( v >= 19900 ? strcpy(#vs, "OFF") : sprintf(#vs, "%.1fk", v*0.001); ) :
  n == 8 ? sprintf(#vs, "%.1fdB", v) :
  n == 9 ? ( v >= 19.9 ? strcpy(#vs, "INF") : sprintf(#vs, "%.1f:1", v); ) :
  n == 10 ? ( v < 1 ? sprintf(#vs, "%.2fms", v) : sprintf(#vs, "%.1fms", v); ) :
  n == 11 ? ( v >= 1990 ? strcpy(#vs, "AUTO") : v >= 1000 ? sprintf(#vs, "%.2fs", v*0.001) : sprintf(#vs, "%.0fms", v); ) :
  n == 13 || n == 20 ? sprintf(#vs, "%.1fdB", v) :
  n == 22 ? sprintf(#vs, "%+.1fdB", v) : sprintf(#vs, "%.1f", v);
);

// ---- interaction
function begin_drag(n) local(now) (
  now = time_precise();
  last_clk_n == n && now - last_clk_t < 0.35 ? (
    sset(n, pdef[n]); end_touch(n); act = 0; last_clk_n = 0;
  ) : (
    act = n; act_t = n2t(n, sget(n)); last_my = my; last_clk_n = n; last_clk_t = now;
  );
);
function wheel_adj(n) local(t) (
  t = n2t(n, sget(n)) + (wheel > 0 ? 1 : -1)*(shift ? 0.005 : 0.03);
  commit(n, min(max(t, 0), 1)); end_touch(n);
);

// ---- widgets
function cell(n, x, y, w, h, lbl) local(hv, t, v, isact) (
  hv = hit(x, y, w, h);
  hv && press && !act ? begin_drag(n);
  hv && wheel != 0 ? wheel_adj(n);
  v = sget(n); t = n2t(n, v); isact = act == n;
  setc(isact); Rbox(x, y, w, h);
  gfx_setfont(1); Rtext(x + 3, y + 3, lbl);
  gfx_setfont(2); fmt(n, v); Rtextc(x, y + floor(h*0.4 + 1), w, #vs);
  Rfill(x + 2, y + h - 4, max(1, floor(t*(w - 4))), 2);
);

function btn(x, y, w, h, str, lit) local(hv, clicked) (
  hv = hit(x, y, w, h);
  clicked = hv && press && !act;
  lit ? ( setc(lit > 1); Rfill(x, y, w, h); setbg(); ) : ( setc(0); Rbox(x, y, w, h); );   // lit 1 = white, 2 = red
  gfx_setfont(1); Rtextc(x, y + floor((h - 8)*0.5), w, str);
  setc(0);
  clicked;
);

function Rtri(x1, y1, x2, y2, x3, y3) (
  gfx_triangle(ox + x1*S, oy + y1*S, ox + x2*S, oy + y2*S, ox + x3*S, oy + y3*S);
);

function shape_name(sel) (
  sel == 0 ? strcpy(#nm, "TUBE") : sel == 1 ? strcpy(#nm, "SOFT") : sel == 2 ? strcpy(#nm, "RATIONAL") :
  sel == 3 ? strcpy(#nm, "ATAN") : sel == 4 ? strcpy(#nm, "HARD") : sel == 5 ? strcpy(#nm, "TRI FOLD") :
  sel == 6 ? strcpy(#nm, "SINE FOLD") : sel == 7 ? strcpy(#nm, "CROSSOVER") : sel == 8 ? strcpy(#nm, "CHEBY") :
  sel == 9 ? strcpy(#nm, "WRAP") : sel == 10 ? strcpy(#nm, "RECTIFY") : sel == 11 ? strcpy(#nm, "BITCRUSH") :
  sel == 12 ? strcpy(#nm, "ASYM FOLD") : strcpy(#nm, "DIODE");
);

// shape selector: [<] NAME [>]. arrows step (wrapping), click the name for the dropdown, wheel steps (clamped)
function selector(n, x, y, w, h) local(hv, sel, r, aw, cy) (
  aw = 16; cy = y + h*0.5;
  hv = hit(x, y, w, h);
  sel = floor(sget(n) + 0.5);
  hv && wheel != 0 ? ( sset(n, min(max(sel + (wheel > 0 ? -1 : 1), 0), 13)); end_touch(n); );
  hv && press && !act ? (
    mx < x + aw ? ( sset(n, sel <= 0 ? 13 : sel - 1); end_touch(n); ) :
    mx >= x + w - aw ? ( sset(n, sel >= 13 ? 0 : sel + 1); end_touch(n); ) : (
      gfx_x = ox + x*S; gfx_y = oy + (y + h)*S;
      r = gfx_showmenu(#menu);
      r > 0 ? ( sset(n, r - 1); end_touch(n); );
      last_down = 0;
    );
    press = 0;
  );
  sel = floor(sget(n) + 0.5);
  setc(0); Rbox(x, y, w, h);
  Rfill(x + aw, y, 1, h); Rfill(x + w - aw - 1, y, 1, h);
  Rtri(x + aw*0.5 + 2, cy - 3, x + aw*0.5 + 2, cy + 3, x + aw*0.5 - 2, cy);
  Rtri(x + w - aw*0.5 - 2, cy - 3, x + w - aw*0.5 - 2, cy + 3, x + w - aw*0.5 + 2, cy);
  gfx_setfont(2); shape_name(sel);
  Rtextc(x + aw, y + 2, w - 2*aw, #nm);
);

// 3-way segmented button. n==23 (gain match): Auto/Match states are red; Match click always (re)starts measuring.
function seg3(n, x, y, w, h, a, b, c) local(i, sx, sw, sel, hv) (
  sel = floor(sget(n) + 0.5); sw = floor(w/3); i = 0;
  loop(3,
    sx = x + i*sw;
    hv = hit(sx, y, sw, h);
    hv && press && !act ? (
      sset(n, i); end_touch(n);
      n == 23 && i == 2 ? ( match_req = 1; );
    );
    i == sel ? (
      setc(n == 23 && i > 0 && !(i == 2 && meas && (floor(time_precise()*4) & 1))); Rfill(sx, y, sw, h);
      setbg();
    ) : ( setc(0); Rbox(sx, y, sw, h); );
    gfx_setfont(1);
    i == 0 ? Rtextc(sx, y + 4, sw, a) : i == 1 ? Rtextc(sx, y + 4, sw, b) : Rtextc(sx, y + 4, sw, c);
    i += 1;
  );
  setc(0);
);

// IN>OUT readout with a centre-tap bar: grows right = output louder than input, left = quieter (+-12 dB full scale)
function diff_box(x, y, w, h) local(cx, bw, d) (
  setc(0); Rbox(x, y, w, h);
  gfx_setfont(1); Rtext(x + 3, y + 3, "IN>OUT");
  gfx_setfont(2); sprintf(#vs, "%+.1fdB", diff_disp); Rtextc(x, y + floor(h*0.4 + 1), w, #vs);
  cx = x + floor(w*0.5);
  d = min(max(diff_disp, -12), 12)/12; bw = floor(abs(d)*(w*0.5 - 3));
  d >= 0 ? Rfill(cx, y + h - 4, bw, 2) : Rfill(cx - bw, y + h - 4, bw, 2);
  Rfill(cx, y + h - 6, 1, 5);
);

function rng_val(i) ( i <= 0 ? 3 : i == 1 ? 6 : i == 2 ? 12 : 18; );

// GR meter: range 3/6/12/18 dB, click cycles, auto-widens when GR exceeds the range (never auto-narrows)
function draw_meter(x, y, w, h) local(g, hp, j, cnt, stp, v, ty, rg, mj, major) (
  g = gr_pk; gr_pk = 0;
  gr_disp = max(g, gr_disp*0.9);
  now2 = time_precise();
  g >= gr_hold ? ( gr_hold = g; gr_hold_t = now2; ) : ( now2 - gr_hold_t > 1 ? gr_hold = max(gr_hold - 0.4, 0); );
  hit(x, y, w, h) && press && !act ? ( gr_ri = gr_ri >= 3 ? 0 : gr_ri + 1; press = 0; );
  while (gr_ri < 3 && gr_disp > rng_val(gr_ri)) ( gr_ri += 1; );
  rg = rng_val(gr_ri);
  setc(0); Rbox(x, y, w, h);
  setc(1); Rfill(x + 1, y + 1, w - 2, floor((h - 2)*min(gr_disp/rg, 1)));
  setc(0);
  hp = y + 1 + floor((h - 3)*min(gr_hold/rg, 1));
  Rfill(x + 1, hp, w - 2, 1);
  gfx_setfont(1);
  mj = rg == 3 ? 1 : rg == 6 ? 2 : rg == 12 ? 3 : 6;      // labelled step (dB)
  stp = rg <= 6 ? 0.5 : 1;                                 // tick step (dB)
  cnt = rg/stp; j = 1;
  loop(cnt,
    v = j*stp;
    ty = y + 1 + (h - 2)*(v/rg);
    major = v == floor(v) && (floor(v) % mj) == 0;
    major ? (
      Rfill(x + w - 5, ty, 4, 1);
      sprintf(#vs, "%d", v); Rtext(x + 2, min(ty - 4, y + h - 11), #vs);   // last label sits above the bottom edge
    ) : Rfill(x + w - 3, ty, 2, 1);
    j += 1;
  );
);

// header output meter: L/R peak bars (-48..0 dB, white) with peak-hold ticks, red rect at the right end when the output clipped.
// click resets clip + held peak.
function lvf(v) ( min(max((8.6858896*log(max(v, 0.0000001)) + 48)/48, 0), 1); );
function out_meter(x, y, w, h) local(pa, pb, bw, bh, rw) (
  rw = 8; bw = w - rw - 2; bh = floor((h - 3)*0.5);
  now2 = time_precise();
  pa = opkL; opkL = 0; pb = opkR; opkR = 0;
  clip_f ? ( clip_lat = 1; clip_f = 0; );   // latched until clicked
  hit(x, y, w, h) && press && !act ? ( opk_max = 0; clip_lat = 0; hlL = hlR = 0; press = 0; );
  ovl = max(pa, ovl*0.85); ovr = max(pb, ovr*0.85);
  pa >= hlL ? ( hlL = pa; hlL_t = now2; ) : ( now2 - hlL_t > 1 ? hlL *= 0.9; );
  pb >= hlR ? ( hlR = pb; hlR_t = now2; ) : ( now2 - hlR_t > 1 ? hlR *= 0.9; );
  opk_max = max(opk_max, max(pa, pb));
  setc(0); Rbox(x, y, bw, h);
  Rfill(x + 1, y + 1, floor((bw - 2)*lvf(ovl)), bh);
  Rfill(x + 1, y + 2 + bh, floor((bw - 2)*lvf(ovr)), bh);
  hlL > 0.0001 ? Rfill(x + 1 + floor((bw - 3)*lvf(hlL)), y + 1, 1, bh);
  hlR > 0.0001 ? Rfill(x + 1 + floor((bw - 3)*lvf(hlR)), y + 2 + bh, 1, bh);
  clip_lat ? ( setc(1); Rfill(x + bw + 2, y, rw, h); ) : ( setc(0); Rbox(x + bw + 2, y, rw, h); );
  setc(0);
);

// sat transfer plot. live: the part of the curve the signal currently reaches (peak, ~150 ms decay) is drawn red, with a dot at each end.
function draw_plot(x, y, w, h) local(i, n, vx, vy, px, py, lx, ly, pk, hv, tb, tot, ty) (
  // interaction: drag/wheel/double-click = SAT OUT; click the bottom-right readout = measure + match sat loudness (3 s)
  hv = hit(x, y, w, h); tb = hit(x + w - 84, y + h - 14, 82, 12);
  hv && press && !act ? ( tb ? ( sat_req = 1; press = 0; ) : begin_drag(27); );
  hv && wheel != 0 ? wheel_adj(27);
  setc(act == 27); Rbox(x, y, w, h);
  i = 0; loop(floor(w/2), Rfill(x + i*2, y + floor(h/2), 1, 1); i += 1; );
  i = 0; loop(floor(h/2), Rfill(x + floor(w/2), y + i*2, 1, 1); i += 1; );
  pk = min(sat_vz, 1);
  n = 64; i = 0;
  loop(n + 1,
    vx = -1 + 2*i/n;
    vy = sat_on ? lutf(vx*pre + bias) : vx;
    vy = min(max(vy, -1), 1);
    px = x + (vx + 1)*0.5*(w - 1); py = y + (1 - (vy + 1)*0.5)*(h - 1);
    setc(sat_on && pk > 0.002 && abs(vx) <= pk);
    i > 0 ? Rline(lx, ly, px, py);
    lx = px; ly = py; i += 1;
  );
  sat_on && pk > 0.002 ? (
    setc(1);
    vy = min(max(lutf(pk*pre + bias), -1), 1);
    Rfill(x + (pk + 1)*0.5*(w - 1) - 1, y + (1 - (vy + 1)*0.5)*(h - 1) - 1, 3, 3);
    vy = min(max(lutf(-pk*pre + bias), -1), 1);
    Rfill(x + (1 - pk)*0.5*(w - 1) - 1, y + (1 - (vy + 1)*0.5)*(h - 1) - 1, 3, 3);
    setc(0);
  );
  // SAT OUT: level marker on the left edge (-24..+12 dB), full dotted line while dragging, readouts in the corners
  tot = slider27;
  ty = y + (1 - (min(max(tot, -24), 12) + 24)/36)*(h - 3);
  setc(act == 27); Rfill(x + 1, ty, 7, 2);
  act == 27 ? ( i = 0; loop(floor(w/3), Rfill(x + i*3, ty, 1, 1); i += 1; ); );
  setc(0);
  gfx_setfont(1);
  sprintf(#vs, "OUT %+.1fdB", tot); Rtext(x + 10, y + 3, #vs);
  sat_meas ? (
    setc(floor(time_precise()*4) & 1); sprintf(#vs, "MEAS %.1fs", sat_mt);
  ) : sprintf(#vs, "SAT %+.1fdB", sat_db);
  Rtextc(x + w - 84, y + h - 14, 82, #vs);
  setc(0);
);

// comp transfer plot. live: red fill under the curve up to the current detector level, dot on the curve at that level.
function draw_ccurve(x, y, w, h) local(i, n, xin, yout, px, py, lx, ly, tx, lvl) (
  setc(0); Rbox(x, y, w, h);
  lvl = min(max(8.6858896*log(max(vz_lv, 0.000001)), -48), 0);
  setc(1);
  i = 0;
  loop(w - 2,
    xin = -48 + 48*i/(w - 3);
    xin <= lvl ? (
      py = y + (1 - (xin - gcomp(xin) + 48)/48)*(h - 1);
      Rfill(x + 1 + i, py, 1, y + h - 1 - py);
    );
    i += 1;
  );
  setc(0);
  i = 0; loop(floor(w/3), Rfill(x + i*3 + 1, y + h - 1 - floor((i*3)*(h - 1)/(w - 1)), 1, 1); i += 1; );   // 1:1 reference
  n = 96; i = 0;
  loop(n + 1,
    xin = -48 + 48*i/n;
    yout = xin - gcomp(xin);
    px = x + (i/n)*(w - 1); py = y + (1 - (yout + 48)/48)*(h - 1);
    i > 0 ? Rline(lx, ly, px, py);
    lx = px; ly = py; i += 1;
  );
  lvl > -47.9 ? (
    px = x + (lvl + 48)/48*(w - 1); py = y + (1 - (lvl - gcomp(lvl) + 48)/48)*(h - 1);
    Rfill(px - 1, py - 1, 3, 3);
  );
  tx = x + (thr + 48)/48*(w - 1);
  Rfill(tx, y + h - 4, 1, 3);
  gfx_setfont(1); Rtext(x + 3, y + 2, "COMPRESSOR");
);

// build halfband taps once
mk_taps(tpA, 24, 8);
mk_taps(tpB, 8, 6);

// ---- state defaults
last_shape = -1; per_on = 0; last_os = -1; dirty = 1; sr_prev = 0; wp = 0;
ims = oms = 0.000000001; og = 1; atrim = 0; meas = 0; match_req = 0; prev_gmode = 0;
prevL = prevR = 0; grfL = grfR = grsL = grsR = 0; rmL = rmR = 0;
pk_env = 0; ms_env = 0; gavg = 0; dcxL = dcyL = dcxR = dcyR = 0;
gr_blk = 0; gr_pk = 0; diff_db = 0; gate_open = 0; macc = 0; mt = 0;
lat = 0; os = 0; sat_on = 0; thr = -18; knw = 6; cslope = 0.75; kc0 = 1; kc1 = 0; kc2 = 0;
pre = 1; bias = 0; mix = 1; mk = 1; og_t = 1;
smix = 1; byp = 0; byp_s = 0; bg = bg_t = 1; pms = 0.000000001; fms = 0.000000001;
delta_on = 0; d_s = 0;
sg = sg_t = 1; sms = 0.000000001; sat_db = 0; sat_meas = 0; sat_req = 0; sat_macc = 0; sat_mt = 0; diff_disp = 0;
inv = 0;   // UI palette: 0 = white on black, 1 = black on white
opkL = opkR = 0; clip_f = 0; vz_blk = vz_lv = sat_blk = sat_vz = 0;

@slider
dirty = 1;

@block
// =========================================================== derived params
match_req ? ( meas = 1; macc = 0; mt = 0; match_req = 0; );
dirty || srate != sr_prev ? (
  dirty = 0; sr_prev = srate;

  // ---- SAT
  slider1 != last_shape ? (
    last_shape = slider1; build_lut(floor(slider1 + 0.5));
    sel_i = floor(slider1 + 0.5); per_on = sel_i == 5 || sel_i == 6 || sel_i == 9 || sel_i == 12;
  );
  pre = exp(slider2*0.01*36*0.11512925);
  bias = slider3*0.01;
  sat_on = slider2 > 0 || slider3 != 0;
  use_hp = slider4 > 20.5;  use_hp ? bq_hp(hpc, slider4, 0.70710678);
  use_lp = slider5 < 19900; use_lp ? bq_lp(lpc, slider5, 0.70710678);
  use_tone = slider6 < 19900; use_tone ? bq_lp(tnc, slider6, 0.70710678);
  os = floor(slider7 + 0.5);
  os != last_os ? ( last_os = os; memset(stAL, 0, 520); memset(resL, 0, 128); );
  lat = os == 0 ? 0 : os == 1 ? 24 : 28;
  pdc_delay = lat; pdc_bot_ch = 0; pdc_top_ch = 2;
  dcR = 1 - 2*$pi*5/srate;

  // ---- COMP
  thr = slider8;
  invR = slider9 >= 19.9 ? 0 : 1/slider9;
  cslope = 1 - invR;
  knw = slider13;
  sh2 = slider14*0.02;
  sh2 <= 1 ? ( kc0 = 1 - sh2; kc1 = sh2; kc2 = 0; ) : ( kc0 = 0; kc1 = 2 - sh2; kc2 = sh2 - 1; );
  spd = pow(4, (slider12 - 50)/50);                       // 0.25x .. 4x, low = fast
  a_att = 1 - exp(-1/(srate*max(slider10*0.001*spd, 0.00001)));
  auto_rel = slider11 >= 1990;
  a_rel = 1 - exp(-1/(srate*max(slider11*0.001*spd, 0.00001)));
  a_relF = auto_rel ? 1 - exp(-1/(srate*0.04*spd)) : a_rel;
  a_relS = 1 - exp(-1/(srate*0.6*spd));
  rms_c = 1 - exp(-1/(srate*0.01));
  pk_d = exp(-1/(srate*0.05));
  ms_c = 1 - exp(-1/(srate*0.3));
  avg_c = 1 - exp(-1/(srate*0.25));
  det_m = slider15*0.01;
  use_dhp = slider16 > 15; use_dhp ? bq_hp(dhc, slider16, 0.70710678);
  link = slider17*0.01; link_full = slider17 >= 99.9;
  fb = slider18*0.01;
  gdist = slider19*0.01;
  mk = exp(slider20*0.11512925);
  mix = slider21*0.01;
  gmode = floor(slider23 + 0.5);
  gmode == 2 && prev_gmode != 2 ? ( meas = 1; macc = 0; mt = 0; );
  gmode != 2 ? ( meas = 0; );
  prev_gmode = gmode;
  rmsg_c = 1 - exp(-1/(srate*0.5));
  og_c = 1 - exp(-1/(srate*0.02));
  smix = slider25*0.01;
  byp = slider26 >= 0.5;
  byp_c = 1 - exp(-1/(srate*0.01));
  bg_c = 1 - exp(-1/(srate*0.2));
  fms_c = 1 - exp(-1/(srate*0.3));
);

// =========================================================== gain diff / auto / match
gate_open = ims > 0.000001;
gate_open ? (
  diff_db = 4.3429448*log(max(oms, 0.000000000001)/max(ims, 0.000000000001));         // pre Out Gain: drives Auto/Match
  diff_disp = 4.3429448*log(max(pms, 0.000000000001)/max(ims, 0.000000000001));       // post Out Gain + trim: IN>OUT display
  sat_db = 4.3429448*log(max(sms, 0.000000000001)/max(ims, 0.000000000001));          // sat module loudness change, before SAT OUT
);
// sat level-match: click starts a 3 s measurement of the sat module's loudness change (like Match), then writes Sat Out. click again = cancel.
sat_req ? ( sat_meas = !sat_meas; sat_macc = 0; sat_mt = 0; sat_req = 0; );
sat_meas && gate_open ? (
  sat_macc += sat_db*(samplesblock/srate); sat_mt += samplesblock/srate;
  sat_mt >= 3 ? (
    slider27 = floor(min(max(-sat_macc/sat_mt, -24), 12)*10 + 0.5)*0.1; sliderchange(2^26);
    sat_meas = 0;
  );
);
sg_t = exp(slider27*0.11512925);
gmode == 1 && gate_open ? (
  atrim += (min(max(-diff_db, -12), 12) - atrim)*(1 - exp(-samplesblock/(srate*1.5)));
);
meas && gate_open ? (
  macc += diff_db*(samplesblock/srate); mt += samplesblock/srate;
  mt >= 3 ? (
    slider24 = min(max(-macc/mt, -12), 12); sliderchange(2^23);
    meas = 0;
  );
);
og_t = exp((slider22 + (gmode == 1 ? atrim : gmode == 2 ? slider24 : 0))*0.11512925);
gr_pk = max(gr_pk, gr_blk); gr_blk = 0;
// viz taps: peak with ~150 ms decay (comp detector level, sat input level)
vz_d = exp(-samplesblock/(srate*0.15));
vz_lv = max(vz_blk, vz_lv*vz_d); vz_blk = 0;
sat_vz = max(sat_blk, sat_vz*vz_d); sat_blk = 0;

@sample
inL = spl0; inR = spl1;
ims += ((inL*inL + inR*inR)*0.5 + 0.000000000000000000000000000001 - ims)*rmsg_c;

wp = (wp + 1) & 63;
dryL[wp] = inL; dryR[wp] = inR;
rd = (wp - lat + 64) & 63;
dlL = dryL[rd]; dlR = dryR[rd];

// ------------------------------------------------------------ SAT
sat_on ? (
  bpL = inL; bpR = inR;
  use_hp ? ( bpL = bq(hpsL, hpc, bpL); bpR = bq(hpsR, hpc, bpR); );
  use_lp ? ( bpL = bq(lpsL, lpc, bpL); bpR = bq(lpsR, lpc, bpR); );
  resL[wp] = inL - bpL; resR[wp] = inR - bpR;
  bdL[wp] = bpL; bdR[wp] = bpR;
  sat_blk = max(sat_blk, max(abs(bpL), abs(bpR)));
  shL = sh_proc(stAL, stBL, bpL*pre + bias);
  shR = sh_proc(stAR, stBR, bpR*pre + bias);
  // DC blocker after shaper (always on in this path)
  yL = shL - dcxL + dcR*dcyL + 0.000000000000000000000000000001; dcxL = shL; dcyL = yL;
  yR = shR - dcxR + dcR*dcyR + 0.000000000000000000000000000001; dcxR = shR; dcyR = yR;
  use_tone ? ( yL = bq(tnsL, tnc, yL); yR = bq(tnsR, tnc, yR); );
  // sat mix: parallel blend of the (latency-aligned) clean band against the shaped signal, before the comp
  smix < 0.999 ? (
    yL = bdL[rd] + (yL - bdL[rd])*smix;
    yR = bdR[rd] + (yR - bdR[rd])*smix;
  );
  cL =resL[rd] + yL; cR = resR[rd] + yR;
) : (
  resL[wp] = 0; resR[wp] = 0;
  cL = dlL; cR = dlR;
);

// SAT OUT: master level of the sat module (applies to blended sat output, also with sat bypassed) = comp input level
sms += ((cL*cL + cR*cR)*0.5 + 0.000000000000000000000000000001 - sms)*rmsg_c;     // sat module loudness, before SAT OUT
sg += (sg_t - sg)*og_c;
cL *= sg; cR *= sg;

// ------------------------------------------------------------ COMP
xdL = cL + fb*(prevL - cL);
xdR = cR + fb*(prevR - cR);
use_dhp ? ( xdL = bq(dhsL, dhc, xdL); xdR = bq(dhsR, dhc, xdR); );
aL = abs(xdL); aR = abs(xdR);
rmL += (xdL*xdL + 0.000000000000000000000000000001 - rmL)*rms_c;
rmR += (xdR*xdR + 0.000000000000000000000000000001 - rmR)*rms_c;
det_m > 0 ? (
  lvL = aL + det_m*(1.41421356*sqrt(rmL) - aL);
  lvR = aR + det_m*(1.41421356*sqrt(rmR) - aR);
) : ( lvL = aL; lvR = aR; );
lmx = max(lvL, lvR);
vz_blk = max(vz_blk, lmx);
lvL += link*(lmx - lvL); lvR += link*(lmx - lvR);

tgL = gcomp(8.6858896*log(max(lvL, 0.000001)));
tgR = link_full ? tgL : gcomp(8.6858896*log(max(lvR, 0.000001)));

tgL > grfL ? ( grfL += (tgL - grfL)*a_att; ) : ( grfL += (tgL - grfL)*a_relF; );
tgR > grfR ? ( grfR += (tgR - grfR)*a_att; ) : ( grfR += (tgR - grfR)*a_relF; );
grfL < 0.000000001 ? ( grfL = 0; ); grfR < 0.000000001 ? ( grfR = 0; );

auto_rel ? (
  tgL > grsL ? ( grsL += (tgL - grsL)*a_att; ) : ( grsL += (tgL - grsL)*a_relS; );
  tgR > grsR ? ( grsR += (tgR - grsR)*a_att; ) : ( grsR += (tgR - grsR)*a_relS; );
  grsL < 0.000000001 ? ( grsL = 0; ); grsR < 0.000000001 ? ( grsR = 0; );
  pk_env = max(lmx, pk_env*pk_d);
  ms_env += (lmx*lmx + 0.000000000000000000000000000001 - ms_env)*ms_c;
  crest = pk_env/(sqrt(ms_env) + 0.000000001);
  cn = min(max((crest - 1.5)*0.2857, 0), 1);            // sine ~1.4 -> 0, sharp transients (>=5) -> 1
  gavg += (max(grfL, grfR) - gavg)*avg_c;
  wgt = 0.1 + 0.75*min(gavg*0.1111, 1)*(1 - cn);         // clamped 0.1 .. 0.85: deep+sustained -> slow
  gL = grfL + wgt*(grsL - grfL);
  gR = grfR + wgt*(grsR - grfR);
) : ( gL = grfL; gR = grfR; );

yL = cL*exp(-gL*0.11512925);
yR = cR*exp(-gR*0.11512925);
gdist > 0 ? (
  ddL = gdist*min(gL*0.0833333, 1);
  ddR = gdist*min(gR*0.0833333, 1);
  yL += ddL*(yL/(1 + 0.5*abs(yL)) - yL);
  yR += ddR*(yR/(1 + 0.5*abs(yR)) - yR);
);
prevL = yL; prevR = yR;                  // feedback tap: pre-makeup, previous sample

// ------------------------------------------------------------ OUT
wL = yL*mk; wR = yR*mk;
oL = dlL + (wL - dlL)*mix;
oR = dlR + (wR - dlR)*mix;
oms += ((oL*oL + oR*oR)*0.5 + 0.000000000000000000000000000001 - oms)*rmsg_c;     // measured before out gain
og += (og_t - og)*og_c;
pL = oL*og; pR = oR*og;
pms += ((pL*pL + pR*pR)*0.5 + 0.000000000000000000000000000001 - pms)*rmsg_c;     // processed loudness (post out gain)
// equal-loudness bypass: dry (latency-aligned) scaled to the processed loudness; gain holds while input is silent
byp_s += ((byp ? 1 : 0) - byp_s)*byp_c;
gate_open ? ( bg_t = min(max(sqrt(pms/ims), 0.0631), 15.85); );
bg += (bg_t - bg)*bg_c;
spl0 = pL + (dlL*bg - pL)*byp_s;
spl1 = pR + (dlR*bg - pR)*byp_s;
// delta monitor: replaces the output with what the compressor removes (comp input - comp output, pre-makeup). UI-only toggle, not saved.
d_s += ((delta_on ? 1 : 0) - d_s)*byp_c;
d_s > 0.0001 ? (
  spl0 += ((cL - yL) - spl0)*d_s;
  spl1 += ((cR - yR) - spl1)*d_s;
);
// output metering taps (consumed by @gfx)
opkL = max(opkL, abs(spl0)); opkR = max(opkR, abs(spl1));
abs(spl0) > 0.9999 || abs(spl1) > 0.9999 ? ( clip_f = 1; );
fms += ((spl0*spl0 + spl1*spl1)*0.5 + 0.000000000000000000000000000001 - fms)*fms_c;
gr_blk = max(gr_blk, max(gL, gR));

@serialize
file_var(0, inv);   // UI palette persists with the project / preset

@gfx 1120 672
// ================================================================== UI
// Logical canvas 560 x 336, drawn at scale S (0.25 steps) and centred. The layout always keeps this aspect:
// a resized window just letterboxes (JSFX has no API to constrain the host window itself).
gfx_clear = inv ? 16777215 : 0;   // background

// ---------- one-time setup
ui_init == 0 ? (
  ui_init = 1;
  setp(2, 0, 100, 25, 0, 0, 0.5);
  setp(3, -100, 100, 0, 0, 0, 1);
  setp(4, 20, 2000, 20, 1, 1, 1);
  setp(5, 1000, 20000, 20000, 1, 2, 10);
  setp(6, 1000, 20000, 20000, 1, 2, 10);
  setp(8, -40, 0, -18, 0, 0, 0.1);
  setp(9, 1, 20, 4, 1, 2, 0.1);
  setp(10, 0.05, 100, 10, 1, 0, 0.01);
  setp(11, 5, 2000, 150, 1, 2, 1);
  setp(12, 0, 100, 50, 0, 0, 1);
  setp(13, 0, 24, 6, 0, 0, 0.1);
  setp(14, 0, 100, 0, 0, 0, 1);
  setp(15, 0, 100, 30, 0, 0, 1);
  setp(16, 0, 400, 0, 2, 1, 1);
  setp(17, 0, 100, 100, 0, 0, 1);
  setp(18, 0, 100, 0, 0, 0, 1);
  setp(19, 0, 100, 0, 0, 0, 1);
  setp(20, 0, 24, 0, 0, 0, 0.1);
  setp(21, 0, 100, 100, 0, 0, 1);
  setp(22, -24, 12, 0, 0, 0, 0.1);
  setp(25, 0, 100, 100, 0, 0, 1);
  setp(27, -24, 12, 0, 0, 0, 0.1);
  setp(1, 0, 13, 0, 0, 0, 1);
  setp(7, 0, 2, 0, 0, 0, 1);
  setp(23, 0, 2, 0, 0, 0, 1);
  strcpy(#menu, "Tube|Soft|Rational|Atan|Hard|Tri Fold|Sine Fold|Crossover|Cheby|Wrap|Rectify|Bitcrush|Asym Fold|Diode");
  gr_disp = 0; gr_hold = 0; gr_hold_t = 0; gr_ri = 3; font_s = 0; act = 0;
  ovl = ovr = hlL = hlR = hlL_t = hlR_t = opk_max = 0; clip_lat = 0;
);

// ---------- frame setup
S = max(0.5, floor(min(gfx_w/560, gfx_h/336)*4)/4);   // 0.25 steps
ox = floor((gfx_w - 560*S)/2); oy = floor((gfx_h - 336*S)/2);
font_s != S ? ( font_s = S; pick_font(); );

mx = (mouse_x - ox)/S; my = (mouse_y - oy)/S;
down = mouse_cap & 1; press = down && !last_down; shift = mouse_cap & 8;
last_down = down;
wheel = mouse_wheel; mouse_wheel = 0;

// drag update (single active widget)
act ? (
  down ? (
    t_new = min(max(act_t + (last_my - my)*(shift ? 0.0008 : 0.006), 0), 1);
    act_t = t_new;
    commit(act, t_new);
  ) : ( end_touch(act); act = 0; );
);
last_my = my;

